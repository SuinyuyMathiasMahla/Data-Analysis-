# Copy this file to backend/.env and fill in the values. Never commit .env.

APP_ENV=development

# --- Security -----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
REQUIRE_EMAIL_VERIFICATION=false
CORS_ORIGINS=http://localhost:5173

# --- Database (MySQL 8+) ------------------------------------------------------
# Create the schema first:  mysql -u root -p < database/schema.sql
DATABASE_URL=mysql+pymysql://research_app:suinyuy2004@127.0.0.1:3306/academic_research?charset=utf8mb4

# --- File storage -------------------------------------------------------------
STORAGE_BACKEND=local
# STORAGE_DIR defaults to <project>/storage
MAX_UPLOAD_MB=25

# --- AI assistant -------------------------------------------------------------
# none      = no language model; the built-in rule engine answers (clearly labelled)
# openai | gemini | anthropic = hosted provider (needs AI_API_KEY and AI_MODEL)
# local     = OpenAI-compatible server on your machine, e.g. Ollama (no key needed)
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# AI_BASE_URL=http://localhost:11434/v1

# --- E-mail (verification and password reset) ----------------------------------
# Leave SMTP_HOST empty in development: e-mails are printed in the server log.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.org
